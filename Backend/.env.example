# ============================================================
#  Environment Variables — Energy Monitoring Backend
#  คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าที่ถูกต้อง
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=8000
NODE_ENV=production

# ── Database ────────────────────────────────────────────────
# Path ของไฟล์ SQLite (สัมพัทธ์จาก root ของโปรเจกต์)
DB_PATH=./data/energy.db

# ── Security ────────────────────────────────────────────────
# API Key สำหรับ ESP32 ส่งมาใน Header (X-API-Key)
# ตั้งค่าให้ตรงกับโค้ดใน ESP32 Firmware
API_KEY=energy_monitor_secret_key_change_me

# ── Google Sheets API ──────────────────────────────────────
# Path ไปยังไฟล์ Service Account JSON Key
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/google-service-account.json
# Google Sheets ID (เอาจาก URL: docs.google.com/spreadsheets/d/SPREADSHEET_ID/)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
# ชื่อ Sheet tab ที่ต้องการ Append ข้อมูล
GOOGLE_SHEET_NAME=EnergyData
# ชื่อ Sheet สรุปรายวัน (ระบบจะสร้างแท็บให้เองหากยังไม่มี)
GOOGLE_DAILY_SHEET_NAME=DailySummary
# Sheet สรุปค่าไฟรายเดือน (Energy + Demand + Ft + Service + VAT)
GOOGLE_MONTHLY_SHEET_NAME=MonthlyBilling

# ── TOU Tariff (อัตราค่าไฟ MEA/PEA ประเภทที่ 3 แรงดัน 22 kV) ──
TOU_PEAK_RATE=4.1025
TOU_OFF_PEAK_RATE=2.5849
TOU_SERVICE_CHARGE=312.24
# ค่า Demand (บาท/kW), Ft (บาท/kWh), และ VAT สำหรับสูตรใน Google Sheets
DEMAND_RATE=132.93
FT_RATE=0
VAT_RATE=0.07

# ── Timezone ─────────────────────────────────────────────────
TZ=Asia/Bangkok
